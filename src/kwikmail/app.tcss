Screen {
    background: #1a1b26;
    color: #c0caf5;
}
.topbar {
    height: 2;
    padding: 0 1;
    background: #16161e;
    color: #7aa2f7;
    text-style: bold;
}
#workspace { height: 1fr; }
#sidebar {
    width: 22;
    padding: 1;
    background: #16161e;
    border-right: solid #292e42;
}
.section-title { height: 2; color: #9aa5ce; text-style: bold; }
#folders { height: 1fr; background: transparent; border: none; padding: 0; }
#folders > .option-list--option { padding: 0 1; }
OptionList > .option-list--option-highlighted { background: #283457; color: #c0caf5; }
#sidebar-hint { height: 11; color: #9aa5ce; padding-top: 1; }
#mail-list { width: 53%; padding: 0 1; }
#mailbox-title { height: 2; padding-top: 1; color: #bb9af7; text-style: bold; }
#search { height: 3; margin: 0 0 1 0; }
Input { background: #1f2335; border: tall #292e42; }
Input:focus { border: tall #7aa2f7; }
#messages {
    height: 1fr;
    background: #1a1b26;
    border: round #292e42;
    scrollbar-size: 1 1;
}
#messages:focus { border: round #7aa2f7; }
DataTable > .datatable--header { background: #1f2335; color: #9aa5ce; text-style: none; }
DataTable > .datatable--cursor { background: #283457; color: #c0caf5; }
DataTable:focus > .datatable--cursor { background: #283457; color: #c0caf5; }
#list-info { height: 2; color: #9aa5ce; padding-top: 1; }
#preview { width: 1fr; margin: 2 1 2 0; border: round #292e42; }
.message-meta { height: auto; max-height: 11; padding: 1 2; background: #1f2335; }
.message-scroll { height: 1fr; padding: 0 1; scrollbar-size: 1 1; }
Markdown { background: transparent; padding: 0 1; }
MarkdownH1 { color: #7aa2f7; border-bottom: solid #292e42; }
MarkdownH2 { color: #bb9af7; }
MarkdownBlockQuote { border-left: thick #7aa2f7; background: #1f2335; }
#status { height: 1; background: #292e42; color: #9aa5ce; padding: 0 1; }
Footer { background: #16161e; }
FooterKey > .footer-key--key { background: #292e42; color: #7aa2f7; }
FooterKey > .footer-key--description { color: #9aa5ce; }
.compact #sidebar { display: none; }
.narrow #preview { display: none; }
.narrow #mail-list { width: 1fr; }
.bottom-hint { height: 1; color: #7aa2f7; background: #292e42; }
#reader-view { height: 1fr; margin: 1 3; border: round #292e42; }
Picker, AccountPicker, ConfirmSend { align: center middle; background: #000000 60%; }
.picker-dialog {
    width: 72%; max-width: 100; height: 65%; min-height: 12;
    padding: 1 2; border: round #7aa2f7; background: #1a1b26;
}
.dialog-title { height: 2; color: #bb9af7; text-style: bold; }
#picker-options { height: 1fr; border: none; background: transparent; }
.muted { height: auto; color: #9aa5ce; }
.confirm-dialog {
    width: 70%; max-width: 90; height: auto; max-height: 80%; padding: 1 2;
    border: round #e0af68; background: #1a1b26;
}
.confirm-dialog Static { height: auto; }
.confirm-dialog .dialog-title { height: 2; }
#compose-fields { height: auto; margin: 0 2; }
#compose-fields Label { height: 1; color: #9aa5ce; }
#compose-fields Input { height: 3; margin-bottom: 0; }
#compose-content { height: 1fr; margin: 1 2; }
#editor { width: 1fr; height: 1fr; border: round #7aa2f7; background: #1a1b26; }
#compose-preview { width: 1fr; height: 1fr; border: round #292e42; overflow-y: auto; }
#compose-status { height: auto; max-height: 5; padding: 0 2; color: #e0af68; }

.account-dialog { width: 90%; max-width: 120; height: 75%; }
#preview .message-scroll:focus { border-left: solid #7aa2f7; }

#preview { border-title-color: #9aa5ce; border-subtitle-color: #9aa5ce; }
